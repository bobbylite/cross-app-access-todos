# ---------------------------------------------------------------------------
# PingFederate — the IdP that issues the ID-JAG
# ---------------------------------------------------------------------------

# Issuer URL, no trailing slash. Must match the `iss` in the assertions PF signs.
PF_ISSUER=https://pf.example.com

# Optional. Left unset, the JWKS URI is read from
# ${PF_ISSUER}/.well-known/openid-configuration at boot. Set it to skip discovery.
# PF_JWKS_URI=https://pf.example.com/pf/JWKS

# Optional. Override if your discovery document isn't at the default path.
# PF_DISCOVERY_URL=https://pf.example.com/.well-known/openid-configuration

# Optional. Comma-separated paths to IdP signing certificates (PEM or DER) trusted
# out of band, tried in addition to whatever the JWKS publishes.
#
# You need this when PingFederate signs the ID-JAG with a certificate it does not
# publish at /pf/JWKS — the token generator picks its own key, and it is not
# necessarily the OIDC provider key. Confirm with:
#     npx tsx scripts/probe-jwks.ts "<assertion>" --cert ./oauth.crt
#
# Out-of-band certificate distribution is a legitimate pattern, but JWKS is better:
# it survives key rotation without anyone copying a file. Prefer fixing the PF side.
# PF_SIGNING_CERTS=./certs/oauth.crt


# ---------------------------------------------------------------------------
# This Resource Authorization Server
# ---------------------------------------------------------------------------

# Our issuer identifier. THIS IS THE VALUE PINGFEDERATE MUST PUT IN `aud`.
# It is compared as an exact string — a trailing slash or http/https mismatch
# between here and PF's registered audience fails validation at step 4, and the
# error will look like a signature problem if you aren't watching the console.
RESOURCE_AS_ISSUER=http://localhost:8081

AS_PORT=8081

# Lifetime of the access tokens we issue. Short on purpose.
ACCESS_TOKEN_TTL_SECONDS=900

# Leeway for clock drift between here and PingFederate, in seconds.
CLOCK_SKEW_SECONDS=60


# ---------------------------------------------------------------------------
# The todos MCP server (the protected resource)
# ---------------------------------------------------------------------------

# Canonical URI of the MCP server. Becomes the `aud` of the access tokens we
# issue, and the audience the MCP server insists on. Include the /mcp path.
MCP_RESOURCE=http://localhost:8082/mcp

MCP_PORT=8082


# ---------------------------------------------------------------------------
# Client registration
# ---------------------------------------------------------------------------

# The client allowed to redeem ID-JAGs here. This must be the SAME client_id that
# PingFederate puts in the assertion's `client_id` claim — step 5 checks that the
# client authenticating here is the one the assertion was issued to.
CLIENT_ID=agent-client
CLIENT_SECRET=change-me

# Scopes local policy is willing to grant. The granted set is the intersection of
# this and what the ID-JAG asked for.
ALLOWED_SCOPES=todos.read todos.write

# Optional. Where the todos application keeps its records. Defaults to ./data/todos.db,
# created on first run. Use ':memory:' for a throwaway database that starts empty every
# time. `npm run db:reset` deletes it.
# TODOS_DB_PATH=./data/todos.db

