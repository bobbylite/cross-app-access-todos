# Config for the `resource` service (Resource AS + MCP + Todos).
# Copy to resource.env and fill in — or use the config editor at :8090 instead.

# --- PingFederate --------------------------------------------------------------
PF_ISSUER=https://pf.example.com
# PF_DISCOVERY_URL=                          # defaults to PF_ISSUER/.well-known/openid-configuration
# PF_JWKS_URI=                                # set to skip discovery entirely

# --- Resource AS -----------------------------------------------------------------
# This server's own issuer identifier — must match the audience PingFederate is
# configured to mint into the ID-JAG, exactly (no trailing slash).
RESOURCE_AS_ISSUER=http://resource-as:8081
AS_PORT=8081
# ACCESS_TOKEN_TTL_SECONDS=900
# CLOCK_SKEW_SECONDS=60
ALLOWED_SCOPES=todos.read todos.write
# TODOS_DB_PATH=                              # defaults to <repo>/data/todos.db

# --- MCP ---------------------------------------------------------------------------
MCP_RESOURCE=http://todos-mcp:8082/mcp
MCP_PORT=8082

# --- Client credentials (redeems ID-JAGs here; also used by the agent) -------------
CLIENT_ID=todos-agent-client
CLIENT_SECRET=change-me

# --- Telemetry -----------------------------------------------------------------
# OTEL_SERVICE_NAME=todos-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://chat:8083/v1/traces
