# Config for the `chat` service (UI, OIDC login, agent proxy, OTLP collector).
# Copy to chat.env and fill in — or use the config editor at :8090 instead.

# --- PingFederate (for the chat app's own OIDC discovery) --------------------------
PF_ISSUER=https://pf.example.com
# PF_DISCOVERY_URL=

# --- Chat ----------------------------------------------------------------------
CHAT_PORT=8083
AGENT_URL=http://agent:8080/invocations
AUDIT_URL=http://todos-mcp:8082/api/audit

# --- Chat's own OIDC client (human sign-in — a different client than CLIENT_ID
#     above, deliberately: the agent is a different party from what the user signed
#     into). Leave OIDC_CLIENT_ID empty to disable sign-in entirely.
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=                         # leave empty for a public/PKCE-only client
# OIDC_REDIRECT_URI=                          # defaults to http://localhost:8083/auth/callback
# OIDC_SCOPES=openid profile
