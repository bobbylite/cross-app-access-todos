# Config for the `agent` service.
# Copy to agent.env and fill in — or use the config editor at :8090 instead.

# --- XAA token chain ------------------------------------------------------------
PF_TOKEN_ENDPOINT=https://pf.example.com/as/token.oauth2
# Must match resource.env's RESOURCE_AS_ISSUER / MCP_RESOURCE exactly.
RESOURCE_AS_ISSUER=http://resource-as:8081
MCP_RESOURCE=http://todos-mcp:8082/mcp
# Must match resource.env's CLIENT_ID / CLIENT_SECRET exactly.
CLIENT_ID=todos-agent-client
CLIENT_SECRET=change-me
# XAA_SCOPE=todos.read todos.write

# --- Telemetry -----------------------------------------------------------------
XAA_OTLP_TRACES_URL=http://chat:8083/v1/traces
# OTEL_SERVICE_NAME=todos-agent

# --- Model provider --------------------------------------------------------------
# bedrock (default) | anthropic | openai | google | openai-compatible
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-...
MODEL_ID=gpt-4.1

# --- Bedrock (only used when MODEL_PROVIDER=bedrock or unset) ----------------------
# AWS_REGION=us-east-2
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-5

PORT=8080
