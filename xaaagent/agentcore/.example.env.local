# Local config for the todos agent. Gitignored — mirrors what the deployed runtime
# will get from its environment. Generated from the main repo's .env.

AWS_REGION=us-east-2
# Opus 5 and Fable 5 are AccessDenied on this account — the marketplace agreement
# has not been accepted (see: get-foundation-model-availability -> agreementAvailability).
# Haiku 4.5 is the one Claude model fully available here. Switch back to
# us.anthropic.claude-opus-5 once that agreement lands.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Where the agent trades the caller's token for an ID-JAG.
PF_TOKEN_ENDPOINT=https://YOUR-PF-DOMAIN/as/token.oauth2

# Where it redeems that assertion. Must match PF's registered audience exactly.
RESOURCE_AS_ISSUER=http://localhost:8081

# The resource the resulting access token is scoped to.
MCP_RESOURCE=http://localhost:8082/mcp

# The agent authenticates as this client at both token endpoints.
CLIENT_ID=YOUR-CLIENT-ID-HERE
CLIENT_SECRET=YOUR-CLIENT-SECRET-HERE

XAA_SCOPE=todos.read todos.write

# agentcore dev points OTEL_EXPORTER_OTLP_ENDPOINT at a collector on :4318 that
# is not running. The chat app is our collector, so say so explicitly.
XAA_OTLP_TRACES_URL=http://localhost:8083/v1/traces
